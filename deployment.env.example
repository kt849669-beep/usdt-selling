# Configure hosted runtime values through Sites. Do not put secrets in source.
NEXA_PUBLIC_ORIGIN=https://nexa-p2p.mathurmonu62.chatgpt.site
# Blank means all public administrator access is locked.
NEXA_ADMIN_EMAIL=
# Reusable administrator invitation: NX followed by 16 random hexadecimal characters.
# Configure on the server. New registration always requires a valid referral code.
NEXA_REGISTRATION_CODE=
NEXA_ENABLE_GATEWAY_CHECKOUT=false
