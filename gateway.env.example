# Copy manually to .dev.vars only when testing with the provider's approved sandbox.
# Never put an API key in browser code, a VITE_/NEXT_PUBLIC_ variable, chat, or Git.
DIVINEPAY_API_KEY=
# A key or this flag alone cannot enable payments: manual delivery setup and a funded reserve are required.
NEXA_ENABLE_GATEWAY_CHECKOUT=false
# Optional server-only TronGrid quota key for read-only mainnet verification.
TRONGRID_API_KEY=
# No private key is used. Admin sends USDT outside the app, then records and verifies its transaction.
# Contract tests use mocked responses and never create a payment order.
